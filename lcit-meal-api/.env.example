PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://127.0.0.1:5173,http://127.0.0.1:8081

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qlsa

JWT_SECRET=################
# PostgreSQL / Neon. When set, DATABASE_URL takes precedence over DB_*.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
DATABASE_SCHEMA=public

# SSO web login. Enable only after VNPT registers a dedicated Com365 client.
SSO_ENABLED=false
SSO_DISCOVERY_URL=https://login.yenbai.gov.vn/oauth2/oidcdiscovery/.well-known/openid-configuration
SSO_ISSUER=https://login.yenbai.gov.vn:443/oauth2/token
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_TOKEN_AUTH_METHOD=client_secret_post
SSO_REDIRECT_URI=https://com365.lcit.vn:4002/api/auth/sso/callback
SSO_FRONTEND_ORIGIN=https://com365.lcit.vn
